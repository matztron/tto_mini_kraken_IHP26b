; Kraken mini I2C master — single-byte write (fits 20-word IMEM).
; uo[0]=SDA, uo[1]=SCL — use 4.7k pull-ups to 3.3 V.
;
; SET imm: bit0=SDA, bit1=SCL  (set_count=2).
; One TX FIFO byte = one bus transaction:
;   START → 8 data bits (MSB first) → ACK slot → STOP
;
; Push e.g. (addr7 << 1) & 0xFE for address+W. For addr+data, run twice
; (each run does its own START…STOP), or use i2c_bitstream for multi-byte.
;
; Config: SET_COUNT=2, autopull, wrap 0..19.

.program i2c_master
.wrap_target
    pull block
    mov y, osr
    set pins, 2           [2]
    set pins, 0           [2]
    set x, 7
bitloop:
    mov osr, y
    out x, 1
    jmp !x b0
    set pins, 1           [1]
    set pins, 3           [1]
    jmp done
b0:
    set pins, 0           [1]
    set pins, 2           [1]
done:
    mov y, osr
    jmp x-- bitloop
    set pins, 1           [2]
    set pins, 3           [2]
    set pins, 0           [2]
    set pins, 2           [2]
    set pins, 3           [2]
.wrap
